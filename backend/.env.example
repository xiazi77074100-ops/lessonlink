ENVIRONMENT=development

# port 5433 matches docker-compose.yml's postgres service (mapped away from
# the default 5432 to avoid clashing with other local projects); adjust if
# you're running your own local postgres instead.
DATABASE_URL=postgresql+asyncpg://lessonlink:lessonlink@localhost:5433/lessonlink

JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Phase 9 (LINE integration) — see docs/product-requirements.md 2.4
# Create these in the LINE Developers Console: a Provider, a Messaging API
# Channel, and a LIFF App. Not required until Phase 9.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LIFF_ID=
